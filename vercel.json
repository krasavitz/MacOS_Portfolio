{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/simple",
      "destination": "/simple/index.html"
    },
    {
      "source": "/simple/:slug",
      "destination": "/simple/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
